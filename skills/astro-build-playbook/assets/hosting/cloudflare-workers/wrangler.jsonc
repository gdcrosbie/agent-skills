// Cloudflare Workers (Static Assets), asset-only. Install only after the host is confirmed.
// No `main` entry: adding one turns this into a Worker with runtime routes.
// See astro-build-playbook → references/hosting-and-indexing.md.
{
  "name": "<project-name>",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
